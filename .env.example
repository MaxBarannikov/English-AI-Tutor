# Provider: anthropic | openai | ollama
TUTOR_PROVIDER=anthropic

# Per-role models. The analyzer carries the precision requirement, so it is the
# one worth spending on; the responder can be a cheaper model.
TUTOR_RESPONDER_MODEL=claude-opus-5
TUTOR_ANALYZER_MODEL=claude-opus-5
TUTOR_SUMMARY_MODEL=claude-opus-5

# Only used when TUTOR_PROVIDER=ollama
TUTOR_OLLAMA_BASE_URL=http://localhost:11434

TUTOR_CHECKPOINT_DB=sessions.db
TUTOR_DEFAULT_LEVEL=B1

# Optional. JSON: {"<model id>": {"input": <usd per 1M>, "output": <usd per 1M>}}
# Needed to see cost for models tutor/pricing.py does not ship prices for.
# TUTOR_PRICING_FILE=prices.json

# Provider credentials — read by the langchain integrations, not by tutor.config
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
